# Paste into Railway → your service → Variables → Raw Editor.
# Replace every <...>. Generate each secret with:  openssl rand -hex 32

# ── Required ──────────────────────────────────────────────────────────────
# Your Railway domain (Settings → Networking → Generate Domain) or your own domain. Must be https.
APP_URL=https://<your-service>.up.railway.app
# Signs people in. Changing it signs everyone out.
SESSION_SECRET=<openssl rand -hex 32>
# Locks the platform sign-ins stored in the database. NEVER change it after accounts are connected.
TOKEN_KEY=<openssl rand -hex 32>
# Needed once, to create the owner account at https://<APP_URL>/setup?key=<SETUP_KEY>
SETUP_KEY=<openssl rand -hex 12>
# Start with 1 (everything runs except the final post). Set to 0 once a test approval looks right.
DRY_RUN=1

# ── Claude (morning scripts and all the AI helpers) ──────────────────────
ANTHROPIC_API_KEY=<from console.anthropic.com>
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── YouTube numbers and watchlist ────────────────────────────────────────
YOUTUBE_API_KEY=<Google Cloud → YouTube Data API v3 key>

# ── Meta: Instagram + Facebook ───────────────────────────────────────────
META_APP_ID=<Meta app → App settings → Basic>
META_APP_SECRET=<Meta app → App settings → Basic>
# Only with "Facebook Login for Business"; leave empty for classic Facebook Login.
META_CONFIG_ID=
META_GRAPH_VERSION=v26.0

# ── LinkedIn ─────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=<LinkedIn developer app>
LINKEDIN_CLIENT_SECRET=<LinkedIn developer app>
LINKEDIN_VERSION=202609

# ── X ────────────────────────────────────────────────────────────────────
X_CLIENT_ID=<X developer app, OAuth 2.0>
X_CLIENT_SECRET=<X developer app, OAuth 2.0>

# ── Optional ─────────────────────────────────────────────────────────────
# YouTube uploads from the hub, only after Google audits the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_UPLOAD_ENABLED=0
# Lets the webinar page send sign-ups to /api/signups.
SIGNUPS_KEY=
# Lets an outside cron call /api/cron/daily (the worker already does this itself).
CRON_KEY=
# Captions: "local" uses whisper.cpp built into the image (free). "openai" needs OPENAI_API_KEY.
TRANSCRIBE_ENGINE=local
OPENAI_API_KEY=

# ── Already set by the Dockerfile — don't add these ──────────────────────
# PORT, DB_FILE=/data/hub.db, MEDIA_DIR=/data/media, BACKUP_DIR=/data/backups,
# WHISPER_CPP_BIN, WHISPER_MODEL, NODE_ENV
