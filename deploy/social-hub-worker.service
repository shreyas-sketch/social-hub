[Unit]
Description=Social Hub (worker: video edits, posting, daily numbers and scripts)
After=network.target social-hub.service

[Service]
Type=simple
User=socialhub
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/social-hub.env
ExecStart=/usr/bin/npm run worker
Restart=always
RestartSec=10
# ffmpeg is heavy; keep the web app responsive
Nice=5

[Install]
WantedBy=multi-user.target
