# ── Basics ───────────────────────────────────────────────
# The public https address of the hub. Meta downloads videos from it, and every platform sends people back to it.
APP_URL=https://social.example.com
# Long random strings. Generate each with:  openssl rand -hex 32
SESSION_SECRET=
TOKEN_KEY=
CRON_KEY=
# Needed to open /setup and create the first owner (the setup script prints the link). Leave blank on a laptop.
SETUP_KEY=
PORT=3100

# Where the database and videos live (keep these outside the app folder on the server)
DB_FILE=/var/lib/social-hub/hub.db
MEDIA_DIR=/var/lib/social-hub/media
BACKUP_DIR=/var/lib/social-hub/backups

# ── Script writing (Claude API) ─────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Captions ─────────────────────────────────────────────
# local = whisper.cpp on this server (free) · openai = OpenAI Whisper API · none = no captions
TRANSCRIBE_ENGINE=local
WHISPER_CPP_BIN=/opt/whisper/whisper-cli
WHISPER_MODEL=/opt/whisper/ggml-base.en.bin
OPENAI_API_KEY=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ── Meta (Instagram + Facebook) ─────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Only if your Meta app uses "Facebook Login for Business": the configuration id from that product's Configurations page
META_CONFIG_ID=

# ── YouTube ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Turn on only after Google's audit clears (until then uploads are forced private, so the team uploads by hand)
YOUTUBE_UPLOAD_ENABLED=0

# ── LinkedIn ────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202609

# ── X ───────────────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=

# 1 = run everything except the final post call (for testing a fresh install)
DRY_RUN=0

# Optional: the key the webinar side sends with sign-ups to /api/signups (falls back to CRON_KEY)
SIGNUPS_KEY=
